new file mode 100644
index 0000000..f095797
--- /dev/null
+++ b/starform/appobject.go
@@ -0,0 +1,96 @@
+package starform
+
+import (
+	"fmt"
+	"sort"
+	"sync"
+
+	"github.com/canonical/starlark/starlark"
+)
+
+type AppObject struct {
+	name             string
+	attrs            map[string]appObjectAttr
+	attrNames        []string
+	collateAttrNames sync.Once
+}
+
+type appObjectAttr struct {
+	availability []string
+	value        starlark.Value
+}
+
+func NewAppObject(name string) *AppObject {
+	return &AppObject{name: name}
+}
+
+func (ao *AppObject) AddAttr(name string, availability []string, value starlark.Value) {
+	if ao.attrs == nil {
+		ao.attrs = make(map[string]appObjectAttr)
+	}
+	ao.attrs[name] = appObjectAttr{
+		availability: availability,
+		value:        value,
+	}
+	ao.attrNames = append(ao.attrNames, name)
+}
+
+func (ao *AppObject) AddMethod(availability []string, method *starlark.Builtin) {
+	ao.AddAttr(method.Name(), availability, method)
+}
+
+var _ starlark.Value = &AppObject{}
+var _ starlark.HasSafeAttrs = &AppObject{}
+
+func (ao *AppObject) String() string { return ao.name }
+func (ao *AppObject) Type() string   { return ao.name }
+func (ao *AppObject) Freeze() {
+	for _, attr := range ao.attrs {
+		attr.value.Freeze()
+	}
+}
+func (ao *AppObject) Truth() starlark.Bool { return true }
+func (ao *AppObject) Hash() (uint32, error) {
+	return 0, fmt.Errorf("unhashable type: %s", ao.Type())
+}
+
+func (ao *AppObject) Attr(name string) (starlark.Value, error) {
+	return ao.SafeAttr(nil, name)
+}
+
+func (ao *AppObject) SafeAttr(thread *starlark.Thread, name string) (starlark.Value, error) {
+	if err := starlark.CheckSafety(thread, starlark.NotSafe); err != nil {
+		return nil, err
+	}
+
+	attr, ok := ao.attrs[name]
+	if !ok {
+		return nil, nil
+	}
+
+	data, err := getRunData(thread)
+	if err != nil {
+		return nil, err
+	}
+	if err = data.checkAvailable(attr.availability); err != nil {
+		return nil, err
+	}
+
+	ret := attr.value
+	if ret, ok := ret.(*starlark.Builtin); ok {
+		ret = ret.BindReceiver(ao)
+	}
+	return ret, nil
+}
+
+func (ao *AppObject) AttrNames() []string {
+	ao.collateAttrNames.Do(func() {
+		attrNames := make([]string, 0, len(ao.attrs))
+		for attrName := range ao.attrs {
+			attrNames = append(attrNames, attrName)
+		}
+		sort.Strings(attrNames)
+		ao.attrNames = attrNames
+	})
+	return ao.attrNames
+}
diff --git a/starform/appobject_test.go b/starform/appobject_test.go
