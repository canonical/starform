index 0000000..845d297
--- /dev/null
+++ b/starform/appobject_test.go
@@ -0,0 +1,126 @@
+package starform_test
+
+import (
+	"context"
+	"strings"
+	"testing"
+
+	"github.com/canonical/starform/starform"
+	"github.com/canonical/starlark/starlark"
+)
+
+func TestMissingAppObject(t *testing.T) {
+	const expected = "cannot create script set without app object"
+
+	opts := &starform.ScriptSetOptions{}
+	_, err := starform.NewScriptSet(opts)
+	if err == nil {
+		t.Errorf("expected error")
+	} else if err.Error() != expected {
+		t.Errorf("unexpected error: expected %q but got %q", expected, err)
+	}
+}
+
+func TestAppObjectAvailability(t *testing.T) {
+	log := &strings.Builder{}
+	printHandler := func(thread *starlark.Thread, msg string) {
+		log.WriteString(msg)
+		log.WriteByte('\n')
+	}
+	appObject := starform.NewAppObject("juju")
+	appObject.Freeze()
+	opts := &starform.ScriptSetOptions{
+		AppObject:    appObject,
+		PrintHandler: printHandler,
+	}
+	scripts, err := starform.NewScriptSet(opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	err = scripts.LoadSources(context.Background(), []starform.ScriptSource{&testScriptSource{
+		name: "test.star",
+		content: `
+			print('load-phase', juju)
+			def init():
+				print('init-phase', juju)
+		`,
+	}})
+	if err != nil {
+		t.Errorf("unexpected error: %v", err)
+	}
+
+	const expectedLog = "load-phase juju\ninit-phase juju\n"
+	if actualLog := log.String(); actualLog != expectedLog {
+		t.Errorf("output error: expected %q but got %q", expectedLog, actualLog)
+	}
+}
+
+func TestAppObjectFields(t *testing.T) {
+	t.Run("available", func(t *testing.T) {
+		const expectedLog = "toplevel 6\ninit 6\n"
+
+		appObject := starform.NewAppObject("mir")
+		appObject.AddAttr("num_displays", []string{starform.LoadEventName}, starlark.MakeInt(6)) // TODO(kcza): replace LoadEventName with another event.
+		appObject.Freeze()
+
+		log := &strings.Builder{}
+		opts := &starform.ScriptSetOptions{
+			AppObject: appObject,
+			PrintHandler: func(_ *starlark.Thread, msg string) {
+				log.WriteString(msg)
+				log.WriteRune('\n')
+			},
+		}
+		scripts, err := starform.NewScriptSet(opts)
+		if err != nil {
+			t.Fatalf("unexpected error: %v", err)
+		}
+		err = scripts.LoadSources(context.Background(), []starform.ScriptSource{&testScriptSource{
+			name: "test.star",
+			content: `
+				print('toplevel', mir.num_displays)
+				def init():
+					print('init', mir.num_displays)
+			`,
+		}})
+		if err != nil {
+			t.Errorf("unexpected error: %s", err)
+		}
+		if actualLog := log.String(); actualLog != expectedLog {
+			t.Errorf("incorrect log: expected %q but got %q", expectedLog, actualLog)
+		}
+	})
+
+	t.Run("unavailable", func(t *testing.T) {
+		const expect = "cannot load script test.star: feature unavailable during <load>"
+
+		appObject := starform.NewAppObject("lxd")
+		appObject.AddAttr("num_nodes", []string{}, starlark.MakeInt(16))
+		appObject.Freeze()
+
+		opts := &starform.ScriptSetOptions{
+			AppObject: appObject,
+		}
+		scripts, err := starform.NewScriptSet(opts)
+		if err != nil {
+			t.Fatal(err)
+		}
+
+		err = scripts.LoadSources(context.Background(), []starform.ScriptSource{&testScriptSource{
+			name: "test.star",
+			content: `
+				print(lxd.num_nodes)
+				fail('unexpectedly called')
+			`,
+		}})
+		if err == nil {
+			t.Error("expected error")
+		} else if err.Error() != expect {
+			t.Errorf("unexpected error: expected %q but got %q", expect, err)
+		}
+	})
+}
+
+func TestAppObjectMethods(t *testing.T) {
+}
diff --git a/starform/rundata.go b/starform/rundata.go
new file mode 100644
index 0000000..6a811a0
--- /dev/null
+++ b/starform/rundata.go
@@ -0,0 +1,34 @@
+package starform
+
+import (
+	"fmt"
+
+	"github.com/canonical/starlark/starlark"
+)
+
+type runData struct {
+	Name string
+}
+
+const runDataKey = "starform.RunData"
+
+func getRunData(thread *starlark.Thread) (*runData, error) {
+	ret, ok := thread.Local(runDataKey).(*runData)
+	if !ok {
+		return nil, fmt.Errorf("%s overwritten", runDataKey)
+	}
+	return ret, nil
+}
+
+func putRunData(thread *starlark.Thread, data *runData) {
+	thread.SetLocal(runDataKey, data)
+}
+
+func (rd *runData) checkAvailable(availableDuring []string) error {
+	for _, event := range availableDuring {
+		if event == rd.Name {
+			return nil
+		}
+	}
+	return fmt.Errorf("feature unavailable during %s", rd.Name)
+}
